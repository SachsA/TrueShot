# TrueShot — clang-tidy configuration.
#
# Pragmatic ruleset: catches real bugs and modernisation opportunities
# without drowning us in stylistic noise. Tighten when codebase matures.
#
# What we EXPLICITLY don't lint (see rationale in each block below):
#   * Purely stylistic checks that fight the project's 1-line-guard style
#     (`if (x) return;` is idiomatic here, `if (x) { return; }` is verbose).
#   * Checks that produce false positives on OpenGL / ImGui / ENet public APIs
#     (which require C-style void* casts and unmarked-return functions).
#     `performance-no-int-to-ptr` is here for the same reason: the
#     `glVertexAttribPointer` offset argument is an intptr-encoded integer
#     by specification, so there is no cast-free way to write it. Expect
#     more of these in Phase 4 as the renderer grows.
#   * Modernization checks that would touch every declaration for no
#     benefit (`use-auto`, `return-braced-init-list`).
#
# One-off exceptions live in the code as `NOLINTNEXTLINE(<check>)` with a
# comment explaining why, so a single noisy site never costs us the check
# everywhere else. Current suppressions:
#   * src/core/application.cpp — Application::run() cognitive complexity,
#     tracked for extraction in ROADMAP.md Phase 2.
---
Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-special-member-functions,
  -modernize-avoid-c-arrays,
  -performance-no-int-to-ptr,
  -modernize-return-braced-init-list,
  -modernize-use-auto,
  -modernize-use-nodiscard,
  -modernize-use-trailing-return-type,
  -readability-braces-around-statements,
  -readability-convert-member-functions-to-static,
  -readability-else-after-return,
  -readability-identifier-length,
  -readability-implicit-bool-conversion,
  -readability-isolate-declaration,
  -readability-magic-numbers,
  -readability-make-member-function-const,
  -readability-named-parameter,
  -readability-uppercase-literal-suffix

# The codebase is clean, so every enabled check is a hard failure. This is
# the single source of truth: the workflow must NOT pass
# --warnings-as-errors on the command line, or this line becomes a lie and
# the two drift (they did — the config said "" while CI forced "*").
WarningsAsErrors: "*"

# KNOWN LIMITATION — do not "fix" casually.
# This is matched against the path clang-tidy prints, which is absolute on
# CI (/home/runner/work/TrueShot/TrueShot/src/...), so the '^' anchor means
# it never matches there and our headers go unlinted (the last run reported
# "suppressed 1056835 warnings in non-user code" for exactly this reason).
# Un-anchoring it would lint every header for the first time, against
# WarningsAsErrors "*", with an unknown number of new diagnostics. That is
# its own task with its own review — tracked in ROADMAP.md Phase 2.
HeaderFilterRegex: '^(include|src)/.*\.(h|hpp|cpp)$'
FormatStyle: file
