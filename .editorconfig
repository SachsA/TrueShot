# EditorConfig — https://editorconfig.org
# Drives every IDE/editor to use the same whitespace conventions.
root = true

[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true
indent_style             = space
indent_size              = 4

# C++
[*.{c,cc,cpp,h,hpp,inl}]
indent_size = 4

# Build / docs
[*.{cmake,txt,md,yml,yaml,json}]
indent_size = 2

[CMakeLists.txt]
indent_size = 4

# Shell / batch
[*.{sh,bat}]
end_of_line = lf
indent_size = 2

[*.bat]
end_of_line = crlf

# Git commit-message template: extensionless, so it falls under [*].
# Listed explicitly so it's obvious it isn't an oversight.
[.gitmessage]
indent_size = 2

# Generated / vendored — don't touch.
# Keep this list in sync with .gitignore and the Exclude list in .ecrc.
[{build,netcode/build,vcpkg,vcpkg_installed}/**]
trim_trailing_whitespace = false
insert_final_newline     = false
