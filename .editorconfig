# EditorConfig — https://editorconfig.org
# Drives every IDE/editor to use the same whitespace conventions.
root = true

[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true
indent_style             = space
indent_size              = 4

# C++
[*.{c,cc,cpp,h,hpp,inl}]
indent_size = 4

# Build / docs
[*.{cmake,txt,md,yml,yaml,json}]
indent_size = 2

[CMakeLists.txt]
indent_size = 4

# Shell / batch
[*.{sh,bat}]
end_of_line = lf
indent_size = 2

[*.bat]
end_of_line = crlf

# Generated / vendored — don't touch.
[{build,network_module/build,vcpkg_installed}/**]
trim_trailing_whitespace = false
insert_final_newline     = false
